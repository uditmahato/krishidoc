<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Flutter product currently has one light visual language. Preserve
         the same branded system splash even when the phone itself uses dark
         mode, instead of promising a dark app for a fraction of a second. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/kd_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/kd_splash_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
        <item name="android:windowBackground">@color/kd_canvas</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kd_canvas</item>
    </style>
</resources>
